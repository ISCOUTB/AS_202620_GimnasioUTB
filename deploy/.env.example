# Variables del panel Environment de Dokploy (deploy/compose.lab.yaml).
# Dokploy genera deploy/.env con estos valores; nunca se versionan.

# Superusuario del PostgreSQL del Compose. Si el volumen ya existe (S8),
# deben ser EXACTAMENTE los mismos valores que ya tiene Dokploy: la contraseña
# del superusuario queda fijada la primera vez que se crea el volumen.
POSTGRES_DB=gimnasio_utb
POSTGRES_USER=
POSTGRES_PASSWORD=

# Contraseñas de los roles de la aplicación (16 a 128 letras, números, - o _).
# Generar cada una con:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_PASSWORD=

# Secreto del encargado (mínimo 32 caracteres).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERADOR_TOKEN=

# Estudiantes: codigo|correo|nombre|contraseña|cedula separados por ';'.
# La cédula (5 a 12 dígitos) es opcional y permite buscar al estudiante.
# Ejemplo: T00000001|estudiante1@utb.edu.co|Estudiante Uno|una-clave-de-12-o-mas|1000000001
DEMO_STUDENTS=

CORS_ORIGINS=
PORT=3000
