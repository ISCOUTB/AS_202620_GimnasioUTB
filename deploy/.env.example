# PostgreSQL remoto de Supabase: URI del rol gimnasio_runtime.
DATABASE_URL=
# Solo para el servicio manual db-migrate; rol gimnasio_migrator.
DB_MIGRATIONS_URL=
DB_MIGRATIONS_HOST=
DB_MIGRATIONS_TARGET=postgres
DB_MIGRATIONS_PROJECT_REF=

# Auth de Supabase para estudiantes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Fallback heredado si el proyecto aun usa la clave anon.
SUPABASE_ANON_KEY=
# Secreto privado solo para scripts administrativos Auth; nunca API/Flutter.
SUPABASE_SERVICE_ROLE_KEY=

# Secretos y configuracion HTTP del backend.
OPERADOR_TOKEN=
CORS_ORIGINS=
PORT=3000
DATABASE_SSL=true
# Contenido de prod-ca-2021.crt (Supabase) codificado en base64.
DATABASE_SSL_CA_CERT_BASE64=
