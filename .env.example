# Desarrollo local: copiar a .env (ignorado por Git).
PORT=3000

# Rol de la API (solo permisos por columna, sin DDL).
DATABASE_URL=postgresql://gimnasio_runtime:CLAVE_RUNTIME@localhost:5432/gimnasio_utb
# TLS es obligatorio salvo para los hosts locales permitidos
# (localhost, 127.0.0.1, ::1 y "postgres" dentro del Compose).
DATABASE_SSL=false
# CA en PEM para un PostgreSQL remoto con certificado propio (opcional).
DATABASE_SSL_CA_CERT_PATH=
# Alternativa: el mismo PEM codificado en base64 (no definir ambas).
DATABASE_SSL_CA_CERT_BASE64=

# Secreto del operador para registrar accesos (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERADOR_TOKEN=REEMPLAZAR_POR_UN_SECRETO_HEXADECIMAL_DE_64_CARACTERES
# Orígenes web permitidos por CORS, separados por coma (solo Flutter web los necesita).
CORS_ORIGINS=http://localhost:8080

# ---- Herramientas administrativas (nunca las usa la API) ----
# Superusuario, solo para npm run db:bootstrap en un PostgreSQL local.
DB_ADMIN_URL=postgresql://postgres:CLAVE_ADMIN@localhost:5432/gimnasio_utb
DB_BOOTSTRAP_ENABLED=false
# Rol dueño del esquema: db:prepare, db:grant-runtime y db:seed-demo-students.
DB_MIGRATIONS_URL=postgresql://gimnasio_migrator:CLAVE_MIGRATOR@localhost:5432/gimnasio_utb
# Confirmación explícita del destino (host y base exactos de DB_MIGRATIONS_URL).
DB_MIGRATIONS_HOST=localhost
DB_MIGRATIONS_TARGET=gimnasio_utb
DB_INIT_ENABLED=false
DB_MIGRATIONS_ENABLED=false
DB_GRANTS_ENABLED=false
DB_SEED_ENABLED=false
# codigo|correo|nombre|contraseña;codigo|correo|nombre|contraseña
DEMO_STUDENTS=
