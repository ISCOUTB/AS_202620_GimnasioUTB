PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Secreto del operador para POST /api/v1/aforo/acceso (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERADOR_TOKEN=REEMPLAZAR_POR_UN_SECRETO_HEXADECIMAL_DE_64_CARACTERES
# Orígenes web permitidos por CORS, separados por coma (solo Flutter web los necesita).
CORS_ORIGINS=http://localhost:8080
