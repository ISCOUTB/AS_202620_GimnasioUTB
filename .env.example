PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# TLS es obligatorio salvo para los hosts locales permitidos.
DATABASE_SSL=true
# Certificado CA oficial de Supabase en PEM (opcional si ya está en el trust store).
# Ejemplo: ruta local o archivo montado como secreto/configuración en Dokploy.
DATABASE_SSL_CA_CERT_PATH=
# URL de rol separado para inicializar/migrar; no debe usar el rol runtime.
DB_MIGRATIONS_URL=
# URL de rol DML separado para seed/vinculación; nunca se usa en la API.
DB_PROVISIONING_URL=
# URL de rol SELECT-only para reconciliación; nunca se usa en la API.
DB_RECONCILIATION_URL=
# Proyecto Supabase. Se requieren para autenticar estudiantes; no configurar
# valores ficticios. La API los usa exclusivamente en el backend.
SUPABASE_URL=
# Preferida para el encabezado apikey; admite claves sb_publishable_.
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con la clave heredada anon. Se usa solo si la publishable falta.
SUPABASE_ANON_KEY=
# Solo para herramientas administrativas de demostración/reconciliación;
# no es necesaria para la API. Nunca incluir esta clave en Flutter.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto del operador para POST /api/v1/aforo/acceso (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERADOR_TOKEN=REEMPLAZAR_POR_UN_SECRETO_HEXADECIMAL_DE_64_CARACTERES
# Orígenes web permitidos por CORS, separados por coma (solo Flutter web los necesita).
CORS_ORIGINS=http://localhost:8080

# Migraciones: requieren habilitación explícita y confirmar host y nombre
# exactos de DB_MIGRATIONS_URL y el proyecto Supabase. No se ejecutan al iniciar la API.
DB_MIGRATIONS_ENABLED=false
DB_MIGRATIONS_HOST=
DB_MIGRATIONS_TARGET=
DB_MIGRATIONS_PROJECT_REF=

# Inicialización base: requiere activación separada y la misma confirmación de destino.
DB_INIT_ENABLED=false

# Herramientas admin: habilitación explícita y destino exacto de demostración.
DB_PROVISIONING_ENABLED=false
DB_RECONCILIATION_ENABLED=false
DEMO_SUPABASE_PROJECT_REF=
DEMO_DATABASE_HOST=
DEMO_DATABASE_NAME=
DEMO_STUDENT_ID=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_NAME=
DEMO_STUDENT_CEDULA=
DEMO_STUDENT_PASSWORD=
